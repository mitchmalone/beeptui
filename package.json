{
  "name": "beeper-tui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "A terminal client for Beeper — read, watch, and reply across your chat networks without leaving the terminal.",
  "bin": {
    "beeper-tui": "./src/cli/index.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --compile --outfile dist/beeper-tui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@beeper/desktop-api": "5.0.0",
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
