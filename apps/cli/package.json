{
  "name": "@beeptui/cli",
  "version": "0.4.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "A terminal client for Beeper — read, watch, and reply across your chat networks without leaving the terminal.",
  "bin": {
    "beeptui": "./src/cli/index.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "build": "bun build src/cli/index.ts --compile --outfile dist/beeptui",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@beeper/desktop-api": "5.0.0",
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  }
}
